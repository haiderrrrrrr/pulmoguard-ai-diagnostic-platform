SECRET_KEY=replace-with-a-local-secret

# PostgreSQL for local development
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASS=postgres
PG_DB=lung_risk

# Hosted Postgres, for example Neon. Use this instead of PG_* in production.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Mail, optional contact form support
GMAIL_USER=your-email@gmail.com
GMAIL_PASS=your-gmail-app-password
CONTACT_RECEIVER=receiver@example.com

# Gemini chatbot
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional startup demo users
DEMO_USER_NAME=Demo User
DEMO_USER_EMAIL=user@pulmoguard.local
DEMO_USER_PASSWORD=User@12345

DEMO_ADMIN_NAME=Demo Admin
DEMO_ADMIN_EMAIL=admin@pulmoguard.local
DEMO_ADMIN_PASSWORD=Admin@12345
